# Policy-controlled services on the node, separate from application endpoints.
apiVersion: crd.projectcalico.org/v1
kind: FelixConfiguration
metadata:
  name: default
spec:
  failsafeInboundHostPorts:
    - protocol: TCP
      port: 22
      net: @LAN_CIDR@
  failsafeOutboundHostPorts: []
---
apiVersion: crd.projectcalico.org/v1
kind: GlobalNetworkPolicy
metadata:
  name: "@NODE_NAME@-host-services"
spec:
  order: 100
  selector: "homelab/host == '@NODE_NAME@'"
  # Application forwarding is governed by workload policies, not this policy.
  applyOnForward: false
  types: [Ingress, Egress]
  ingress:
    - action: Allow
      source:
        nets: [127.0.0.0/8, "::1/128", @NODE_IP@/32]
    - action: Allow
      protocol: TCP
      source:
        nets: [@LAN_CIDR@]
      destination:
        ports: [22]
    - action: Allow
      protocol: TCP
      source:
        selector: "projectcalico.org/namespace == 'kube-system'"
      destination:
        ports: [6443, 10250]
    - action: Allow
      protocol: TCP
      source:
        selector: "projectcalico.org/namespace == 'flux-system' && app in {'source-controller', 'kustomize-controller', 'helm-controller'}"
      destination:
        ports: [6443]
    - action: Allow
      protocol: UDP
      source:
        nets: [@LAN_CIDR@]
        ports: [67]
      destination:
        ports: [68]
    - action: Allow
      protocol: ICMP
    - action: Allow
      protocol: ICMPv6
    - action: Deny
  egress:
    - action: Allow
      destination:
        nets: [127.0.0.0/8, "::1/128", @NODE_IP@/32, @POD_CIDR@, @SERVICE_CIDR@]
    - action: Allow
      protocol: UDP
      destination:
        nets: @DNS_CIDRS@
        ports: [53]
    - action: Allow
      protocol: TCP
      destination:
        nets: @DNS_CIDRS@
        ports: [53]
    - action: Allow
      protocol: TCP
      destination:
        ports: [80, 443]
    - action: Allow
      protocol: UDP
      destination:
        ports: [123, 67]
    - action: Allow
      protocol: ICMP
    - action: Allow
      protocol: ICMPv6
    - action: Deny
---
apiVersion: crd.projectcalico.org/v1
kind: HostEndpoint
metadata:
  name: "@NODE_NAME@"
  labels:
    homelab/host: "@NODE_NAME@"
spec:
  node: "@NODE_NAME@"
  interfaceName: "*"
  expectedIPs: ["@NODE_IP@"]
